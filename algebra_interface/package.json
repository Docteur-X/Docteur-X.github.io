{
  "name": "algebra-workspace-expression-tree",
  "private": true,
  "type": "module",
  "description": "A dependency-free interactive algebra editor prototype using an expression tree.",
  "scripts": {
    "test": "node scripts/run-node-tests.mjs",
    "test:e2e": "playwright test",
    "test:mutation": "node scripts/mutation-probe.js",
    "test:visual": "playwright test --config=playwright.visual.config.js",
    "test:visual:baseline": "playwright test --config=playwright.visual.config.js --update-snapshots",
    "test:visual:capture": "node scripts/capture-computed-styles.mjs",
    "test:visual:compare": "node scripts/compare-computed-styles.mjs",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "check:docs": "node scripts/check-documentation-links.mjs",
    "report:unused": "node scripts/report-unused.mjs",
    "report:coupling": "node scripts/coupling.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
